# LLM 适配层配置(OpenAI 兼容协议)。复制为 .env 并填值。
# 默认 DeepSeek;换提供商只改这四行,代码不动。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=填你的_key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# Supabase Postgres 连接串 (session pooler, port 5432, IPv4, 支持 prepared statements 给 asyncpg)。
# Supabase dashboard → Project Settings → Database → Connection string → Session pooler 取。
# 主理人已 provision 一个共享 project (ai-interactive-story, ap-southeast-1);真连接串走 Slack/私下要,不进 git。
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ── Phase 0 成本熔断 + 限流(账户系统路线图 Phase 0;见 decisions/2026-06-09-phase0-*)──
# 默认关闭;先跑迁移建表(migrations/2026-06-09-phase0-cost-guard.sql),再设 =1 才生效(门控,可回退)。
COST_GUARD_ENABLED=0
# 全局每日花费硬上限(USD):当天累计 >= 此值 → 整服务停调 LLM(503)。按可接受烧钱上限设。
GLOBAL_DAILY_USD_CAP=5
# 按 IP 限流:窗口秒数 + 窗口内最大回合数。
RATE_WINDOW_SECONDS=3600
RATE_MAX_TURNS_PER_WINDOW=40
# 单来源每日回合上限(宽松;0=不限,靠全局上限兜底)。
SUBJECT_DAILY_TURN_CAP=200
# 每回合预扣 USD(并发熔断用:先扣后按实际对账;设为略高于单回合平均成本)。
COST_RESERVE_USD=0.01
# DeepSeek 价格(USD / 百万 token);务必按当前官网价配,代码内默认仅兜底。
COST_INPUT_USD_PER_MTOK=0.3
COST_OUTPUT_USD_PER_MTOK=1.2

# ── 账户系统(账户系统路线图 Phase 1;见 decisions/2026-06-09-账户系统路线图-*)──
# 默认关闭;先跑迁移(migrations/2026-06-09-phase1-accounts.sql),再设 =1 才按 user 隔离数据(门控,可回退)。
AUTH_ENABLED=0
# token 加盐(可选但建议设一个随机长串):库里存 sha256(token + pepper),改了它会让所有已发 token 失效。
AUTH_TOKEN_PEPPER=
