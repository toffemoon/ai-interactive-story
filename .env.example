# LLM 适配层配置(OpenAI 兼容协议)。复制为 .env 并填值。
# 默认 DeepSeek;换提供商只改这四行,代码不动。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=填你的_key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 默认关闭向量检索,先用关键词/事件/状态保证稳定和速度;需要语义召回时改成 1。
ENABLE_EMBEDDINGS=0

# Supabase Postgres 连接串 (session pooler, port 5432, IPv4, 支持 prepared statements 给 asyncpg)。
# Supabase dashboard → Project Settings → Database → Connection string → Session pooler 取。
# 主理人已 provision 一个共享 project (ai-interactive-story, ap-southeast-1);真连接串走 Slack/私下要,不进 git。
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
